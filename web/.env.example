# Solana Devnet is the target for the live Colosseum demo.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Keep true while external protocol adapters remain reference integrations.
# The Dnipro Devnet Vault route can still execute real on-chain test-USDC deposits/withdrawals.
NEXT_PUBLIC_DEMO_MODE=true

# Already-deployed Dnipro core programs.
NEXT_PUBLIC_DISPATCHER_PROGRAM_ID=BfSctTciPvzNL3KwkNsQnqUmr5tK9R5B7zz6MCT845rt
NEXT_PUBLIC_REGISTRY_PROGRAM_ID=JBSNe6wmCMiJXemkHm7qTRNFaPDd8sjJdwwjYGiAgkfe

# Deploy programs/adapters/devnet-vault in Solana Playground and paste its public program id here.
NEXT_PUBLIC_LIVE_ADAPTER_PROGRAM_ID=

# Official Solana Devnet USDC mint used by Circle's test faucet.
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
