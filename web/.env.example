# Solana RPC used by the reference dashboard.
# Devnet is recommended until Dnipro programs and at least one adapter are deployed and tested.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Keep true while the dashboard uses reference portfolio/APY data.
NEXT_PUBLIC_DEMO_MODE=true

# Optional: set after deployment for UI links / future live transaction wiring.
NEXT_PUBLIC_DISPATCHER_PROGRAM_ID=
NEXT_PUBLIC_REGISTRY_PROGRAM_ID=
